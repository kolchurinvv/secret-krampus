# Copy to .env for local dev (bun loads it automatically). Every value is
# optional in dev: without RESEND_API_KEY emails (and login codes) are printed
# to the server console, and without R2 credentials avatars are stored in
# ./data/avatars and served by the app itself.

# Comma-separated emails that get the /admin page.
ADMIN_EMAILS=you@example.com

# Any long random string in production: `openssl rand -base64 32`.
BETTER_AUTH_SECRET=dev-only-secret-change-me-in-production-please

# Resend (https://resend.com/api-keys). Sending domain must be verified.
RESEND_API_KEY=
EMAIL_FROM=Secret Krampus <krampus@secretkrampus.party>

# Cloudflare R2 — S3 credentials of an *account* API token scoped to the bucket
# (Object Read & Write). The endpoint is the S3 API URL WITHOUT the bucket path.
R2_ENDPOINT=https://f9e371667244609d910373676cf12011.r2.cloudflarestorage.com
R2_BUCKET=secret-krampus
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
AVATAR_BASE_URL=https://img.secretkrampus.party

# Where the browser reaches the app. In dev that's the Vite server.
PUBLIC_URL=http://localhost:5173
