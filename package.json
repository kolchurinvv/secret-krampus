{
  "name": "secret-krampus",
  "private": true,
  "type": "module",
  "scripts": {
    "dev:server": "bun --watch src/server/index.ts",
    "dev:client": "vite",
    "build": "vite build",
    "start": "NODE_ENV=production bun src/server/index.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit -p .",
    "db:generate": "drizzle-kit generate",
    "seed": "bun scripts/seed.ts",
    "test:e2e": "bash scripts/playwright-runner.sh test",
    "test:e2e:headed": "bash scripts/playwright-runner.sh test --headed",
    "test:e2e:watch": "E2E_WATCH=1 bash scripts/playwright-runner.sh test"
  },
  "dependencies": {
    "@fontsource/mountains-of-christmas": "^5.3.0",
    "@hono/bun": "^1.0.1",
    "@solidjs/router": "^1.0.3",
    "beercss": "^5.0.3",
    "better-auth": "^1.7.28",
    "canvas-confetti": "^1.9.4",
    "drizzle-orm": "0.45",
    "hono": "^4.13.22",
    "material-dynamic-colors": "^1.2.0",
    "qrcode": "^1.5.4",
    "resend": "^6.39.0",
    "solid-js": "^1.9.20"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/bun": "^1.4.5",
    "@types/canvas-confetti": "^1.9.0",
    "@types/qrcode": "^1.5.6",
    "drizzle-kit": "0.31",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vite-plugin-solid": "^2.11.17"
  }
}
